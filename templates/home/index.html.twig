{% extends 'base.html.twig' %}

{% block title %}
    TaskFlow — Frontend
{% endblock %}

{% block body %}
    <main
        class="min-h-screen flex items-center
             justify-center px-6 py-12"
    >

        <section
            class="w-full max-w-xl rounded-2xl
                    border border-slate-200 bg-white
                    p-8 shadow-sm"
        >

            <div
                class="mb-6 inline-flex items-center
                    rounded-full bg-brand-100
                    px-3 py-1 text-xs font-semibold
                    text-brand-700"
            >
                Symfony UX + Tailwind
            </div>

            <h1 class="text-3xl font-bold tracking-tight">
                TaskFlow
            </h1>

            <p class="mt-3 text-slate-600">
                Votre environnement frontend est prêt.
            </p>

            <div class="mt-8 flex gap-3">
                <a
                    href="{{ path('app_task_index') }}"
                    class="rounded-lg bg-brand-600 px-5 py-3
                      font-medium text-white
                      hover:bg-brand-700
                      transition-colors"
                >
                    Mes tâches
                </a>

                <a
                    href="{{ path('app_login') }}"
                    class="rounded-lg border border-slate-200
                      px-5 py-3 font-medium
                      hover:bg-slate-50 transition-colors"
                >
                    Connexion
                </a>
            </div>

        </section>
    </main>
{% endblock %}
