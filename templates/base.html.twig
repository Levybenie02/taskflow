<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        >

        <title>
            {% block title %}TaskFlow{% endblock %}
        </title>

        {#
        AssetMapper expose le CSS compilé par TailwindBundle.
        En production, les fichiers seront versionnés.
    #}
        {% block stylesheets %}
            <link
                rel="stylesheet"
                href="{{ asset('styles/app.css') }}"
            >
        {% endblock %}

        {#
        Charge le point d'entrée JS.
        Stimulus et Turbo sont initialisés depuis les assets.
    #}
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>

    <body
        class="min-h-screen bg-slate-50
             font-sans text-slate-900 antialiased"
    >

        {% block body %}{% endblock %}

    </body>
</html>
